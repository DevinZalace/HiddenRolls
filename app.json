{
  "expo": {
    "backgroundColor": "#000000",
    "name": "HiddenRolls",
    "description": "Expo configuration for the Hidden Rolls mobile experience.",
    "slug": "hidden-rolls",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "locales": {
      "en": "src/localization/en.json",
      "es": "src/localization/es.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dntmfg.hiddenrolls",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSBluetoothAlwaysUsageDescription": "Allow Hidden Rolls to connect to and configure your tray over Bluetooth.",
        "NSLocalNetworkUsageDescription": "Allow Hidden Rolls to find and connect to your tray on your local network.",
        "NSBonjourServices": [
          "_hiddenrolls._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.dntmfg.hiddenrolls",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://jitpack.io"
            ]
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Hidden Rolls to scan your tray QR code.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "565ace31-eca9-464f-9920-63265de0eae5"
      }
    },
    "owner": "dnt-mfg-llc"
  }
}
