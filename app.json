{
  "expo": {
    "backgroundColor": "#000000",
    "name": "HiddenRolls",
    "description": "Expo configuration for the Hidden Rolls mobile experience.",
    "slug": "hidden-rolls",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.dntmfg.hiddenrolls"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
    "expo-font",
    [
      "expo-build-properties",
      {
        "android": {
          "extraMavenRepos": [
            "https://jitpack.io"
          ]
        }
      }
    ]
  ],
    "extra": {
      "eas": {
        "projectId": "565ace31-eca9-464f-9920-63265de0eae5"
      }
    },
    "owner": "dnt-mfg-llc"
  }
}
